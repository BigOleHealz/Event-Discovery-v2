# ============================================================
# Event Discovery — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# In production all secrets come from AWS Secrets Manager.
# ============================================================

# ----- App -----
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ----- Database (PostgreSQL + PostGIS) -----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/eventdb

# ----- Qdrant -----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ----- Neo4j (Phase 5) -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-dev-password

# ----- Auth — NextAuth (frontend) -----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ----- Auth — Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Auth — Apple Sign-In -----
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ----- Twilio -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1XXXXXXXXXX

# ----- Spotify (Phase 5) -----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ----- Maps -----
NEXT_PUBLIC_MAPBOX_TOKEN=

# ----- Event Ingestion Sources -----
EVENTBRITE_API_KEY=
MEETUP_API_KEY=

# ----- Task Queue (Celery + Redis) -----
REDIS_URL=redis://localhost:6379/0

# ----- OpenAI (embeddings) -----
OPENAI_API_KEY=

# ----- Admin -----
ADMIN_API_KEY=change-me-in-development

# ----- MSW (API Mocking) -----
NEXT_PUBLIC_API_MOCKING=true
